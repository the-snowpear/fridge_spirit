# 冰箱小精灵 —— 目标无关的公共默认配置。
# 芯片目标专有配置见 sdkconfig.defaults.esp32p4（当前 P4 主线）。
# ESP-IDF 会按 "sdkconfig.defaults + sdkconfig.defaults.<target>" 顺序叠加，后者覆盖前者。

# 使用自定义分区表：大主固件 + 小 recovery、本地资源分区和 coredump。文件名按目标在各自 defaults 指定。
CONFIG_PARTITION_TABLE_CUSTOM=y

# OTA 启动状态：主固件运行在 ota_0，小型 recovery 运行在 ota_1。
# 注意：一大一小后不能再把云端恢复当唯一兜底；recovery 必须保留本地串口/联网恢复入口。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# PSRAM 公共策略：启用、开机自检、malloc 接管；模式与频率属于芯片差异，放在各目标 defaults。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=163840
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 现场调试保留 brownout 和 flash coredump，方便定位供电、看门狗和堆栈问题。
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# 任务看门狗超时直接进入 panic 并写入 Flash coredump，避免卡死后静默重启。
CONFIG_ESP_TASK_WDT_PANIC=y
# coredump 未成功导出前不覆盖上一次现场，待 TF 写入完整后再由固件擦除。
CONFIG_ESP_COREDUMP_FLASH_NO_OVERWRITE=y

# 独立 MIPI 点屏测试默认关闭；SPI/TR230S SCREEN_TEST 路径已移除。
CONFIG_FRIDGE_MIPI_SCREEN_TEST=n

# AI API 测试使用 HTTPS 与系统证书包，不额外在固件中硬编码服务商证书。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# 默认构建 P4 最小主固件。生成 ota_1 recovery 时必须同时：
# 1. 以 -DFRIDGE_RECOVERY_BUILD=ON 配置 CMake；2. 在专用 sdkconfig/defaults 中设本项为 y。
# 两个 profile 开关不一致时 CMake 会主动报错，避免代码路径与依赖闭包错配。
CONFIG_FRIDGE_RECOVERY_APP=n

# MQ-5 可燃气体/烟雾传感器（AO=GPIO20/ADC1_CH4，P4 目标有效；关闭时状态机为 DISABLED）。
CONFIG_FRIDGE_MQ5_ENABLE=y
