# 慧勤智远 ESP32-P4 CB V1.2 专有配置（当前主线目标）。
# 硬件：ESP32-P4NRW32（32MB 片内 PSRAM）+ 16MB W25Q128 QSPI Flash + 板载 ESP32-C6（SDIO, esp_hosted）。
# SDIO/hosted 配置值照抄厂商 WIFI 例程 sdkconfig（doc/慧勤智远.../3，WIFI例程/02_WiFi_STA）与《用户手册》§2.2。

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_recovery_p4.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_recovery_p4.csv"

# 实板 COM15 由 esptool 识别为 ESP32-P4 rev v1.3；IDF 6 默认的 rev v3.1+ 固件与其不兼容。
# P4 rev <3.0 与 >=3.0 硬件差异较大，必须显式选择 v1.x 路径，最低支持 v1.0。
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# rev v1.3 小系统板按厂商例程和板卡标称频率使用 360MHz；rev <3 不保证 400MHz 稳定。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# P4NRW32 片内 32MB HEX PSRAM；厂商例程按 200MHz 使用，若 memtest 不过则降 80MHz。
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# 控制台走 UART0（CH343P，GPIO37/38）：一根 USB 线完成烧录 + 监视器 + JSON Lines 运维。
# USB-C JTAG 口作为次级控制台镜像日志，方便双口调试。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# ---- 板载 ESP32-C6 Wi-Fi（esp_hosted + esp_wifi_remote，SDIO Slot1）----
# Slot1 固定引脚：CMD=47 CLK=48 D0-D3=49-52（与手册 §1.5 一致，必须覆盖组件的通用板默认值）。
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
# Slot1 在该 P4 封装上的真实固定脚。显式写入，避免 hosted 版本默认板型把总线误配到 GPIO14-19。
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=47
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=48
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=49
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=52
# SDIO 引脚域电源管理：片内 LDO4 输出（手册 §2.2 要求，缺失会导致 Wi-Fi 不稳定）。
CONFIG_ESP_HOSTED_SD_PWR_CTRL_LDO_INTERNAL_IO=y
CONFIG_ESP_HOSTED_SD_PWR_CTRL_LDO_IO_ID=4
# C6 复位脚 GPIO54（C6_EN），高有效；每次主机启动时复位 C6，保证 hosted 握手从干净状态开始。
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
# 关闭主机侧休眠唤醒：厂商默认的 host wakeup GPIO6 与 ES8311 的 I2S LRCK 冲突，本项目不用主机休眠。
CONFIG_ESP_HOSTED_HOST_POWER_SAVE_ENABLED=n
# hosted 自带交互 CLI 不读取本项目 UART0，串口只保留 JSON Lines 协议和正常日志。
CONFIG_ESP_HOSTED_CLI_ENABLED=n

# ---- P4 最小移植启动模式（Wi-Fi + 麦克风 + SPI-4WIRE 屏/触摸 + TF 卡）----
CONFIG_FRIDGE_P4_MINIMAL=y
# 20-pin FPC 转杜邦板已作为当前接线方案，启用 FT6336U 独立 I2C 触摸。
CONFIG_FRIDGE_P4_TOUCH_ENABLE=y
