# ESP32-P4 ota_1 recovery profile. 不依赖 LVGL、FreeType、字体包或大 UI 组件。
CONFIG_FRIDGE_RECOVERY_APP=y
CONFIG_FRIDGE_UI_ENABLE=n
CONFIG_FRIDGE_P4_UI_ENABLE=n
CONFIG_FRIDGE_P4_GT911_ENABLE=n
CONFIG_FRIDGE_P4_MIPI_UI_ENABLE=n
CONFIG_FRIDGE_MIPI_SCREEN_TEST=n
CONFIG_FRIDGE_CAMERA_TEST=n
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
