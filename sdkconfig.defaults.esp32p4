# 慧勤智远 ESP32-P4 CB V1.2 专有配置（当前主线目标）。
# 硬件：ESP32-P4NRW32（32MB 片内 PSRAM）+ 16MB W25Q128 QSPI Flash + 板载 ESP32-C6（SDIO, esp_hosted）。
# SDIO/hosted 配置值照抄厂商 WIFI 例程 sdkconfig（doc/慧勤智远.../3，WIFI例程/02_WiFi_STA）与《用户手册》§2.2。

# CH343P 在本板 RAM stub 阶段会出现 Invalid head of packet；固定使用 ROM loader。
CONFIG_ESPTOOLPY_NO_STUB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_recovery_p4.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_recovery_p4.csv"

# 实板 COM15 由 esptool 识别为 ESP32-P4 rev v1.3；主线固定 IDF 5.5.1 + esp-sr 2.4.5，
# 该组合会按 5.5.1 的 PATCH<3 规则选择 esp32p4_less_v3 预编译库，不能升级到 5.5.3+。
CONFIG_ESP32P4_REV_MIN_100=y

# rev v1.3 小系统板按厂商例程和板卡标称频率使用 360MHz；rev <3 不保证 400MHz 稳定。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# P4NRW32 片内 32MB HEX PSRAM；厂商例程按 200MHz 使用，若 memtest 不过则降 80MHz。
# 注意：ESP-IDF 5.5.1 把 P4 PSRAM 200MHz 归为实验特性（SPIRAM_SPEED_200M 依赖
# IDF_EXPERIMENTAL_FEATURES），必须先打开实验特性开关，200M 选项才可见；IDF6 时非实验。
# 该板 PSRAM 实测 200MHz memtest OK（见 doc/memory.md 2026-07-11），保持硬件既定频率。
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# MIPI-DPI 帧缓冲位于 PSRAM，draw_bitmap 会执行 cache write-back。
# 与厂商 09_mipilcd 配置一致，让 DSI/DW-GDMA 帧完成 ISR 在 cache 暂停期间仍可运行并重启 DMA。
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# 控制台走 UART0（CH343P，GPIO37/38）：一根 USB 线完成烧录 + 监视器 + JSON Lines 运维。
# USB-C JTAG 口作为次级控制台镜像日志，方便双口调试。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# ---- 板载 ESP32-C6 Wi-Fi（esp_hosted + esp_wifi_remote，SDIO Slot1）----
# Slot1 固定引脚：CMD=47 CLK=48 D0-D3=49-52（与手册 §1.5 一致，必须覆盖组件的通用板默认值）。
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
# Slot1 在该 P4 封装上的真实固定脚。显式写入，避免 hosted 版本默认板型把总线误配到 GPIO14-19。
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=47
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=48
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=49
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=52
# SDIO 引脚域电源管理：片内 LDO4 输出（手册 §2.2 要求，缺失会导致 Wi-Fi 不稳定）。
CONFIG_ESP_HOSTED_SD_PWR_CTRL_LDO_INTERNAL_IO=y
CONFIG_ESP_HOSTED_SD_PWR_CTRL_LDO_IO_ID=4
# C6 复位脚 GPIO54（C6_EN），高有效；每次主机启动时复位 C6，保证 hosted 握手从干净状态开始。
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
# 本工程 FreeRTOS tick=100Hz；复位后明确等待 1500ms，禁止旧版 1ms 延时被舍入成 0 tick。
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
# 传输缓冲优先走 DMA 可达的片内 PSRAM（P4 的 GDMA 经 cache 可达 PSRAM）。
# ESP-IDF 5.5.1 相比 IDF6 少给 hosted 约 120KB 的 RETENT_RAM 堆区，SDIO mempool 用
# INTERNAL|DMA 约 48KB 在启动早期分配失败（sdio_drv.c:255 assert buf_mp_g）。开启本项
# 后 SDIO 收发缓冲从 PSRAM 分配、失败再回退片内，既修复该崩溃又保住紧张的片内 RAM。
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# 关闭主机侧休眠唤醒：厂商默认的 host wakeup GPIO6 与 ES8311 的 I2S LRCK 冲突，本项目不用主机休眠。
CONFIG_ESP_HOSTED_HOST_POWER_SAVE_ENABLED=n
# hosted 自带交互 CLI 不读取本项目 UART0，串口只保留 JSON Lines 协议和正常日志。
CONFIG_ESP_HOSTED_CLI_ENABLED=n

# ---- P4 最小移植启动模式（Wi-Fi + 麦克风/ASR/WakeNet + SPI 屏/触摸 + TF 卡）----
CONFIG_FRIDGE_P4_MINIMAL=y
# 20-pin FPC 转杜邦板已作为当前接线方案，启用 FT6336U 独立 I2C 触摸。
CONFIG_FRIDGE_P4_TOUCH_ENABLE=y

# ---- ESP-SR WakeNet：P4 板载 ES8311 单麦克风，“小冰小冰”模型写入 model 分区 ----
# 只加载 WakeNet 与 P4 官方示例使用的 VADNet；首版不加载 MultiNet 固定命令模型。
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_WN_WN9_XIAOBINXIAOBIN_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# ---- TF 卡文件管理：UTF-8 API + 简体中文代码页 + 255 字节长文件名 ----
# 长文件名工作区从堆分配，避免目录浏览把较大数组压在 USB/HTTP 任务栈上。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_936=y
