<view class="page rise">
  <view class="kicker">设备绑定</view>
  <view class="title">扫描冰箱贴屏幕二维码</view>
  <view class="subtitle">只接受 P4 设备显示的一次性 v2 绑定二维码，过期后请在设备端重新生成。</view>
  <view class="panel">
    <button class="btn" loading="{{loading}}" bindtap="scanBindingQr">扫描绑定二维码</button>
    <view wx:if="{{errorText}}" class="subtitle" style="color: var(--color-tomato); margin-top: var(--space-3);">{{errorText}}</view>
  </view>
  <view class="panel">
    <view class="kicker">当前设备</view>
    <view wx:if="{{device}}" style="margin-top: var(--space-3);">
      <text class="title" style="font-size: var(--text-md);">{{device.name || device.deviceSn}}</text>
      <view class="subtitle">SN：{{device.deviceSn}} · {{device.status}}</view>
    </view>
    <view wx:else class="empty">还没有绑定设备</view>
  </view>
</view>
