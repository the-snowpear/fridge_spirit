<view class="page inventory-page rise">
  <view class="hello-bar">
    <view class="col">
      <view class="kicker">三级库存</view>
      <view class="title">食材位置</view>
    </view>
    <view class="row actions">
      <view class="pill" bindtap="onTapRefreshDevice">↻ 刷新</view>
      <view class="pill" bindtap="onTapScan">+ 入库</view>
    </view>
  </view>

  <view class="breadcrumb">
    <text class="{{level === 'zone' ? 'current' : ''}}" bindtap="onTapRootLevel">冰箱</text>
    <block wx:if="{{activeZone}}">
      <text class="divider">/</text>
      <text class="{{level === 'layer' ? 'current' : ''}}" bindtap="onTapZoneLevel">{{activeZoneLabel}}</text>
    </block>
    <block wx:if="{{activeLayer}}">
      <text class="divider">/</text>
      <text class="current">{{activeLayerLabel}}</text>
    </block>
  </view>

  <view wx:if="{{errorText}}" class="panel error-panel">
    <view class="kicker error-title">加载失败</view>
    <view class="subtitle">{{errorText}}</view>
    <button class="btn ghost retry" bindtap="load">重试</button>
  </view>

  <view wx:if="{{!errorText && level !== 'cell'}}" class="summary-list">
    <view wx:for="{{summaries}}" wx:key="key" class="panel summary-card" data-key="{{item.key}}" bindtap="onTapSummary">
      <view>
        <view class="summary-title">{{item.label}}</view>
        <view class="subtitle">{{item.hint}}</view>
      </view>
      <view class="summary-meta">
        <view wx:if="{{item.warnCount}}" class="warn-dot">{{item.warnCount}} 临期</view>
        <view class="count">{{item.count}} 件</view>
        <view class="arrow">›</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!errorText && level === 'cell'}}" class="grid-board">
    <view wx:for="{{cells}}" wx:key="cell" class="cell {{item.occupied ? 'occupied' : 'empty'}} {{item.level || ''}}" data-cell="{{item.cell}}" bindtap="onTapCell">
      <view class="cell-slot">{{item.code}}</view>
      <block wx:if="{{item.occupied}}">
        <view class="cell-name">{{item.item.name}}</view>
        <view class="cell-meta">{{item.item.quantityText}}</view>
        <view wx:if="{{item.expireText}}" class="cell-expire">{{item.expireText}}</view>
      </block>
      <view wx:else class="cell-plus">+</view>
    </view>
  </view>

  <block wx:if="{{unplaced.length}}">
    <view class="kicker unplaced-title">待归位</view>
    <view class="list">
      <view wx:for="{{unplaced}}" wx:key="id" class="panel item-card" data-id="{{item.id}}" bindtap="onTapItem">
        <view class="row">
          <view>
            <view class="item-name">{{item.name}}</view>
            <view class="subtitle">{{item.quantityText}} · {{item.locationText}}</view>
          </view>
          <view class="arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !errorText && items.length === 0}}" class="empty">还没有库存，点击“入库”添加食材</view>
</view>
