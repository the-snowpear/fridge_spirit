<view class="page nutrition-page rise">
  <view class="hello-bar">
    <view class="col">
      <view class="kicker">营养助手</view>
      <view class="title">今日膳食观察</view>
    </view>
    <view class="pill" bindtap="onTapRefresh">{{loading ? '生成中' : '刷新'}}</view>
  </view>

  <view wx:if="{{errorText}}" class="panel error-panel">
    <view class="kicker">生成失败</view>
    <view class="subtitle">{{errorText}}</view>
  </view>

  <view class="panel score-panel">
    <view class="score-ring">
      <view class="score-value">{{view.score}}</view>
      <view class="score-label">均衡分</view>
    </view>
    <view class="score-copy">
      <view class="kicker">AI 建议</view>
      <view class="score-summary">{{view.summary}}</view>
      <view class="score-meta">最近生成：{{view.generatedText}}</view>
    </view>
  </view>

  <view class="nutrition-section">
    <view class="section-title">今日重点</view>
    <view class="focus-row">
      <view wx:for="{{view.focus}}" wx:key="*this" class="tag mint">{{item}}</view>
    </view>
  </view>

  <view class="suggestion-list">
    <view wx:for="{{view.suggestions}}" wx:key="*this" class="suggestion-row">
      <view class="suggestion-dot"></view>
      <view class="suggestion-text">{{item}}</view>
    </view>
  </view>

  <view class="panel restrict-panel">
    <view class="kicker">忌口提醒</view>
    <view class="subtitle">{{view.restrictNote}}</view>
  </view>

  <view class="nutrition-section">
    <view class="section-title">同步饮食记录</view>
    <view class="record-list">
      <view wx:for="{{records}}" wx:key="id" class="record-row">
        <view class="row">
          <view class="record-title">{{item.title}}</view>
          <view class="record-time">{{item.consumedText}}</view>
        </view>
        <view class="record-nutrients">{{item.nutrientText}}</view>
        <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
      </view>
      <view wx:if="{{records.length === 0}}" class="empty compact">暂无设备同步的饮食记录</view>
    </view>
  </view>

  <button class="btn" loading="{{loading}}" bindtap="onTapRefresh">按当前库存生成营养建议</button>
</view>
