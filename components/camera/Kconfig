menu "Fridge Spirit Camera"

    config FRIDGE_CAMERA_PREVIEW_MAX_BYTES
        int "Maximum JPEG bytes returned as USB preview"
        default 65536
        range 8192 131072
        help
            If the captured JPEG exceeds this size, camera_capture returns an
            error instead of pushing a very large JSON line over Web Serial.

    config FRIDGE_CAMERA_HD_PREVIEW
        bool "Enable OV5647 MIPI-CSI HD fullscreen preview (ESP32-P4)"
        depends on IDF_TARGET_ESP32P4
        default y
        help
            Build the P4 HD preview path (esp_video + OV5647 + PPA to MIPI LCD).
            Requires shared I2C gate with ES8311 and a ready MIPI display.

endmenu
